<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- A published page: its HTML may come through a site's proxy, and its
    styles, scripts, files and live socket from the notebook's own address. --%>
    <meta name="live-socket" content={NotebookWeb.Endpoint.url() <> "/public/live"} />
    <%!-- The page's own icon, else the site's (Notebook settings → Publishing),
    else the notebook's. --%>
    <% site_icon = Notebook.Publishing.site_image_url(Notebook.Publishing.config().icon) %>
    <% favicon = assigns[:favicon] || site_icon %>
    <link
      :if={is_nil(favicon)}
      rel="icon"
      href={static_url(NotebookWeb.Endpoint, ~p"/images/favicon.svg")}
      type="image/svg+xml"
    />
    <link :if={favicon} rel="icon" href={favicon} />
    <%!-- A phone's home screen takes an image, not an emoji's SVG. --%>
    <% touch = if(favicon && !String.starts_with?(favicon, "data:"), do: favicon, else: site_icon) %>
    <link :if={touch} rel="apple-touch-icon" href={touch} />
    <meta name="theme-color" content="#f6f3ec" />
    <.live_title
      default={Notebook.Publishing.config().name}
      suffix={" · " <> Notebook.Publishing.config().name}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:description]} name="description" content={@description} />
    <link :if={assigns[:canonical]} rel="canonical" href={@canonical} />
    <meta :if={assigns[:canonical]} property="og:url" content={@canonical} />
    <meta :if={assigns[:page_title]} property="og:title" content={@page_title} />
    <meta :if={assigns[:description]} property="og:description" content={@description} />
    <meta property="og:site_name" content={Notebook.Publishing.config().name} />
    <%!-- The picture of a link shared: the page's first image, else the site's. --%>
    <meta
      :if={assigns[:og_image] || Notebook.Publishing.config().image}
      property="og:image"
      content={
        assigns[:og_image] ||
          Notebook.Publishing.site_image_url(Notebook.Publishing.config().image)
      }
    />
    <meta property="og:type" content={if assigns[:kind] == :page, do: "article", else: "website"} />
    <meta
      name="twitter:card"
      content={
        if assigns[:og_image] || Notebook.Publishing.config().image,
          do: "summary_large_image",
          else: "summary"
      }
    />
    <meta :if={assigns[:page_title]} name="twitter:title" content={@page_title} />
    <meta :if={assigns[:description]} name="twitter:description" content={@description} />
    <link
      :if={assigns[:feed]}
      rel="alternate"
      type="application/rss+xml"
      title={assigns[:page_title]}
      href={@feed}
    />
    <link
      phx-track-static
      rel="stylesheet"
      href={static_url(NotebookWeb.Endpoint, ~p"/assets/css/app.css")}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={static_url(NotebookWeb.Endpoint, ~p"/assets/js/app.js")}
    >
    </script>
  </head>
  <body class="public-body">
    {@inner_content}
  </body>
</html>
