<main id="landing" class="landing">
  <Layouts.flash_group flash={@flash} />
  <section class="landing-hero">
    <div class="landing-copy">
      <p class="eyebrow">Pages you host yourself</p>
      <h1>Write together.<br />With your people,<br />and your agents.</h1>
      <p class="landing-lede">
        A shared notebook for words, boards, tables and databases. Everyone on a page
        writes at once, and Claude Code or Codex writes beside you, on your own server.
      </p>
      <div class="landing-actions">
        <.link id="landing-log-in" href={~p"/users/log-in"} class="button button-primary">
          Log in <span aria-hidden="true">↗</span>
        </.link>
        <.link
          :if={not @invite_only}
          id="landing-register"
          href={~p"/users/register"}
          class="button"
        >
          Create an account
        </.link>
      </div>
      <p :if={@invite_only} id="landing-invite-only" class="landing-note">
        This notebook is invite only. Ask one of its admins for a link.
      </p>
    </div>
    <div class="landing-mark" aria-hidden="true">
      <img src={~p"/images/notebook/logo.svg"} alt="" width="320" height="320" />
    </div>
  </section>

  <section class="landing-features" aria-label="What it does">
    <div>
      <.icon name="hero-pencil-square" class="size-5" />
      <h2>Pages of every kind</h2>
      <p>
        Text, boards of cards and arrows, tables of tasks, and databases with your own fields.
      </p>
    </div>
    <div>
      <.icon name="hero-users" class="size-5" />
      <h2>Together, live</h2>
      <p>
        See who is on a page and where they point. Comment, mention, and get told what concerns you.
      </p>
    </div>
    <div>
      <Icons.robot class="size-5" />
      <h2>Agents beside you</h2>
      <p>
        Connect Claude Code or Codex. Your agent edits the page with you, under the same rules.
      </p>
    </div>
    <div>
      <.icon name="hero-server" class="size-5" />
      <h2>Yours</h2>
      <p>
        Your server, one SQLite file, your files on its disk or in your bucket. Open, or invite only.
      </p>
    </div>
  </section>

  <section class="landing-made" aria-labelledby="landing-made-title">
    <p id="landing-made-title" class="eyebrow">Made with open source</p>
    <ul class="landing-logos">
      <li :for={library <- @libraries}>
        <.link href={~p"/made-with"} title={"#{library.name}: #{library.kind}"}>
          <img
            src={"/images/libraries/#{library.id}.svg"}
            alt={library.name}
            width="40"
            height="40"
          />
        </.link>
      </li>
    </ul>
    <.link href={~p"/made-with"} class="landing-made-link">
      Hattori AI's libraries for Phoenix →
    </.link>
  </section>
</main>
