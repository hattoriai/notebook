# Copy to .kamal/secrets (ignored by git) and fill in. Values may also read
# from the environment: SECRET_KEY_BASE=$SECRET_KEY_BASE

# The registry's login (for ghcr.io: your GitHub user, and a token that
# may write packages).
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# mix phx.gen.secret
SECRET_KEY_BASE=
# openssl rand -base64 32. Keep it with your backups: it encrypts the
# notebook's secrets (a bucket's key), and another one cannot read them.
NOTEBOOK_VAULT_KEY=
